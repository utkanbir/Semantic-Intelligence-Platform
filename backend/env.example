# SIP backend configuration (copy to .env for local development; do not commit secrets)
SIP_APP_NAME=sip-backend
SIP_ENVIRONMENT=development
SIP_DEBUG=true
SIP_HOST=0.0.0.0
SIP_PORT=8000
SIP_API_V1_PREFIX=/api/v1
SIP_LOG_LEVEL=info

# PostgreSQL (Alembic / SQLAlchemy) — see README for Kubernetes Service DNS
# Local example:
# SIP_DATABASE_URL=postgresql+psycopg://sip_user:replace-me@localhost:5432/sip_db
# In-cluster (sip-dev namespace):
# SIP_DATABASE_URL=postgresql+psycopg://sip_user:replace-me@sip-postgres.sip-dev.svc.cluster.local:5432/sip_db
SIP_DATABASE_URL=postgresql+psycopg://sip_user:replace-me@localhost:5432/sip_db
